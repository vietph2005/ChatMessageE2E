# RAG Pipeline — Cấu hình API Keys
# =====================================
# SAO CHÉP file này thành ".env" (xóa đuôi .example)
# và điền key thực vào. File .env đã được gitignore — an toàn tuyệt đối.

# Google Gemini API Key (lấy miễn phí tại https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key_here
